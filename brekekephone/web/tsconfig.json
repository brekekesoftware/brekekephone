{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "vite-plugin-svgr/client"],
    "paths": {
      "@/*": ["../app/src/*"]
    }
  },
  "include": ["./*", "./**/*", "../app/src/**/*", "../../declaration.d.ts"]
}
